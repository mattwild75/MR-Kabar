# Dipakai VITE_APP_NAME di bawah, dan dari situ menjadi judul tab peramban
# ("Masuk - MR KABAR"). Kalau dikosongkan atau dihapus, resources/js/app.tsx
# jatuh ke nilai cadangannya — dan seluruh tab berbunyi "Laravel".
APP_NAME="MR KABAR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Asia/Jakarta (WIB), BUKAN UTC. Seluruh penggunanya di WIB, dan Laravel
# menyimpan kolom datetime sebagai waktu dinding pada zona ini tanpa penanda
# zona — jadi UTC membuat tiap cap waktu di layar tertinggal 7 jam dari jam
# dinding pengguna. Mengubah nilai ini pada basis data yang sudah berisi WAJIB
# disertai penggeseran isinya; lihat migrasi pindahkan_zona_waktu_ke_asia_jakarta.
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=react_stater_kits
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Batas bawaan Laravel (menganggur, bergeser tiap request). Sengaja
# LEBIH PANJANG dari SESSION_MAX_LIFETIME supaya tidak pernah ikut
# menentukan - yang menentukan hanya batas sejak login di bawah.
SESSION_LIFETIME=600

# Satu-satunya penghitung yang berlaku: menit sejak LOGIN, mutlak.
SESSION_MAX_LIFETIME=240
# Berapa detik sebelum habis peringatan muncul.
SESSION_WARNING_SECONDS=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# WAJIB 'local', jangan 'public'. Berkas media (File Manager dan Bukti Dukung
# Risiko) disimpan lewat Spatie MediaLibrary, yang membuat URL langsung ke
# berkas fisik. Kalau disknya 'public', berkas itu ter-mount di /storage dan
# bisa dibaca SIAPA PUN tanpa login lewat URL yang mudah ditebak - otorisasi
# di controller hanya melindungi daftar dan penghapusannya, bukan isi
# berkasnya. Dengan 'local', satu-satunya jalur baca adalah
# MediaDownloadController, yang memeriksa kepemilikan lebih dulu.
MEDIA_DISK=local

# Jalur folder binari mysqldump/mysql, dipakai fitur Backup dan snapshot versi.
# Dikosongkan berarti mysqldump dicari di PATH; di Windows dengan DBngin ia
# TIDAK ada di PATH, dan tanpa baris ini seluruh fitur Backup gagal tanpa
# pesan yang menjelaskan sebabnya.
# Contoh (DBngin di Windows):
# DB_DUMP_COMMAND_PATH="C:/Users/NAMA/AppData/Local/com.tinyapp.DBngin/Binaries/mysql/8.4.2/bin"
DB_DUMP_COMMAND_PATH=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Surel: dengan "log" tidak ada yang terkirim (lupa sandi, peringatan server,
# laporan mingguan hanya masuk lonceng). Untuk Gmail akun perencanaan:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=perencanaaninspektoratabar@gmail.com
#   MAIL_PASSWORD=<sandi aplikasi 16 huruf dari myaccount.google.com/apppasswords>
#   MAIL_FROM_ADDRESS=perencanaaninspektoratabar@gmail.com  MAIL_FROM_NAME="MR Kabar"
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Password akun bersama "LAPOR" (Lapor Kejadian Risiko, dipakai publik lewat
# QR code) — isi dengan password sesuai kebijakan Anda, JANGAN commit nilai
# aslinya ke git (file .env sendiri sudah di-gitignore).
LAPOR_ACCOUNT_PASSWORD=

# Password akun bersama "CEE_Survey" (kuesioner CEE lintas-OPD, dipakai lewat
# QR code) — sama alasan dgn LAPOR_ACCOUNT_PASSWORD di atas.
CEE_SURVEY_ACCOUNT_PASSWORD=

# Catatan: fitur "Git Push"/"Git Pull" (menu Backup > Super Admin) TIDAK
# diaktifkan lewat .env — nonaktif secara default di setiap instalasi baru,
# dan hanya bisa diaktifkan lewat toggle di halaman Backup itu sendiri
# (kolom git_sync_enabled di tabel settingapp) setelah Anda memastikan
# remote git di server ini sudah mengarah ke repository Anda sendiri.

# Sandi arsip cadangan (AES-256). WAJIB di produksi: dump-nya memuat hash sandi
# semua pengguna. Samakan dengan /etc/mrkabar/kunci-cadangan milik cron root.
BACKUP_ARCHIVE_PASSWORD=

# Basis data uji untuk cadangan:uji-pulih (wajib beda dari DB_DATABASE dan memuat kata uji)
DB_UJI_PULIH=mrkabar_uji_pulih
